# Copia a .env.local (local) o configúralas en Vercel → Settings → Environment Variables.
# Son SOLO de servidor: nunca uses el prefijo NEXT_PUBLIC_.

# IA opcional (Google Gemini, plan gratuito de Google AI Studio, sin facturación).
# Mientras estén vacías, las funciones de IA permanecen desactivadas.
AI_API_KEY=
# Secreto largo y aleatorio. La app lo envía en cada llamada de IA para que
# nadie más pueda gastar tu cuota a través de la URL pública.
APP_ACCESS_TOKEN=
# Opcional. Modelo de Gemini a usar.
AI_MODEL=gemini-2.5-flash
